{
  "openapi": "3.2.1",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "nb1 本地设备执行 API",
    "version": "0.1.0-local",
    "description": "当前本地候选实现，未发布。仅loopback HTTP，无用户认证；拒绝非本地Host及跨源浏览器控制。请求使用规范小写字段名；未知字段、非规范字段大小写、重复对象键、显式null、尾随JSON和超过64层的嵌套被拒绝。省略默认字段合法，repeat=0规范为1。可选request_id/expected_daemon_instance_id绑定仅在同一daemon实例的有限回执内去重；旧提交无需准备步骤，客户端无自动重试，不提供跨重启exactly-once。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "description": "以server启动JSON事件的url为准。",
      "variables": {
        "port": {
          "default": "8931"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "health"
    },
    {
      "name": "devices"
    },
    {
      "name": "jobs"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "health"
        ],
        "summary": "查询HTTP服务是否响应",
        "description": "ok不表示任何硬件在线；设备状态另查devices。",
        "responses": {
          "200": {
            "description": "服务正在响应。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "405": {
            "$ref": "#/components/responses/405"
          }
        }
      }
    },
    "/v1/devices": {
      "get": {
        "operationId": "listDevices",
        "tags": [
          "devices"
        ],
        "summary": "列出daemon已配置设备",
        "description": "包含配置中但离线的设备；不是对所有USB进行即刻枚举。直控CLI devices为另一种元数据发现入口。",
        "responses": {
          "200": {
            "description": "设备缓存状态，按序列号排序。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceState"
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "405": {
            "$ref": "#/components/responses/405"
          }
        }
      }
    },
    "/v1/devices/{serial}": {
      "parameters": [
        {
          "name": "serial",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "description": "明确配置的真实序列号；无索引或别名解析。"
          }
        }
      ],
      "get": {
        "operationId": "getDeviceState",
        "tags": [
          "devices"
        ],
        "summary": "取得最近设备状态快照",
        "responses": {
          "200": {
            "description": "状态存在，即使connection为offline仍返回200。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceState"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/v1/devices/{serial}/jobs": {
      "parameters": [
        {
          "name": "serial",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "description": "明确配置的真实序列号；无索引或别名解析。"
          }
        }
      ],
      "post": {
        "operationId": "runProgram",
        "tags": [
          "jobs"
        ],
        "summary": "提交结构化灯光程序",
        "description": "job不随HTTP连接结束而取消。无自动USB回退、无Flash/设备模式写入。可选二元组启用同实例有限去重；首次与重放均202并返回原Job当前状态，失败/取消任务不重执行。无键调用保留每次新任务行为。",
        "x-max-body-bytes": 1048576,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "首次准入或原任务重放，均返回202，包括原任务已终态；保存原binding和Location。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "无键时为job查询路径；有键时为含原实例query的回执查询路径。",
                "schema": {
                  "type": "string"
                }
              },
              "X-NB1-Replayed": {
                "description": "仅有键提交存在；true代表返回既有任务，非重新执行。",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              },
              "X-NB1-Daemon-Instance-ID": {
                "description": "仅有键提交存在，确认原实例绑定。",
                "schema": {
                  "type": "string",
                  "pattern": "^daemon_[0-9a-f]{32}$",
                  "description": "原daemon实例绑定；实例改变时旧结果仍可能未知，不可自动换绑。"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "415": {
            "$ref": "#/components/responses/415"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          },
          "410": {
            "$ref": "#/components/responses/410"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "501": {
            "$ref": "#/components/responses/501"
          }
        },
        "x-max-json-depth": 64
      }
    },
    "/v1/jobs/{jobId}": {
      "parameters": [
        {
          "name": "jobId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^job_[0-9a-f]{32}$"
          }
        }
      ],
      "get": {
        "operationId": "getJob",
        "tags": [
          "jobs"
        ],
        "summary": "查询一个内存任务记录",
        "responses": {
          "200": {
            "description": "当前任务状态。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/v1/jobs/{jobId}/cancel": {
      "parameters": [
        {
          "name": "jobId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^job_[0-9a-f]{32}$"
          }
        }
      ],
      "post": {
        "operationId": "cancelJob",
        "tags": [
          "jobs"
        ],
        "summary": "请求取消任务",
        "description": "可不带请求体；如携带，则必须是application/json空对象。返回202及真实job状态，活动任务通常先cancelling，停止/熄灯/读回成功后才cancelled；已有终态不改变。排队任务直接移除，不停止其他活动任务。",
        "x-max-body-bytes": 1048576,
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyObject"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "取消请求已处理；不能把202当作设备已经停止。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "415": {
            "$ref": "#/components/responses/415"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "x-max-json-depth": 64
      }
    },
    "/v1/transport-metrics": {
      "get": {
        "operationId": "getTransportMetrics",
        "tags": [
          "devices"
        ],
        "summary": "查询SDK操作级传输与重试计数",
        "description": "不额外访问USB。driver未提供计数时返回空数组。calls是逻辑SDK操作，attempts含初次尝试，retries是额外尝试，failures是最终失败；不是原始USB transfer计数。last_error可能来自已恢复操作。",
        "responses": {
          "200": {
            "description": "累积计数快照，进程重启后不保留。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransportMetric"
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "405": {
            "$ref": "#/components/responses/405"
          }
        }
      }
    },
    "/v1/instance": {
      "get": {
        "operationId": "getDaemonInstance",
        "tags": [
          "health"
        ],
        "summary": "读取可选回执能力与新请求前缀",
        "description": "只读，不分配回执或操作USB。客户端将prefix与16随机字节的小写hex组合并保存实例二元组；旧服务可404/501，不自动降级。",
        "responses": {
          "200": {
            "description": "本实例与有限回执限额。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceInfo"
                }
              }
            },
            "headers": {
              "X-NB1-Daemon-Instance-ID": {
                "schema": {
                  "type": "string",
                  "pattern": "^daemon_[0-9a-f]{32}$",
                  "description": "原daemon实例绑定；实例改变时旧结果仍可能未知，不可自动换绑。"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "501": {
            "$ref": "#/components/responses/501"
          }
        }
      }
    },
    "/v1/devices/{serial}/requests/{request_id}": {
      "parameters": [
        {
          "name": "serial",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "description": "明确配置的真实序列号；无索引或别名解析。"
          }
        },
        {
          "name": "request_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^req_[1-9][0-9]{0,18}_[0-9a-f]{32}$",
            "description": "服务端request_id_prefix追加128bit小写hex nonce。截止点是daemon单调uptime毫秒；服务端另查int64溢出、过期及最大60000ms准入窗口。"
          }
        },
        {
          "name": "expected_daemon_instance_id",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^daemon_[0-9a-f]{32}$",
            "description": "原daemon实例绑定；实例改变时旧结果仍可能未知，不可自动换绑。"
          },
          "description": "必须恰好一个非空参数；不接受未知或重复query参数。"
        }
      ],
      "get": {
        "operationId": "getRequestReceipt",
        "tags": [
          "jobs"
        ],
        "summary": "按原实例与请求键查原Job",
        "description": "普通job历史淘汰后，有效回执仍可返回原任务的当前状态。404仅表示查询时未找到，410/实例409保留旧结果未知，不重建或重绑任务。",
        "responses": {
          "200": {
            "description": "原Job当前快照，无新任务副作用。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "headers": {
              "X-NB1-Daemon-Instance-ID": {
                "schema": {
                  "type": "string",
                  "pattern": "^daemon_[0-9a-f]{32}$",
                  "description": "原daemon实例绑定；实例改变时旧结果仍可能未知，不可自动换绑。"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "410": {
            "$ref": "#/components/responses/410"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StepRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "color"
        ],
        "properties": {
          "led": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ],
            "default": 0,
            "description": "0=两颗，1/2=单颗；省略按0，显式null拒绝。"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "description": "原始RGB，无隐式Gamma；字母会规范为小写。"
          },
          "fade_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600000,
            "multipleOf": 10,
            "default": 0,
            "description": "淡入毫秒数，10ms整数倍；省略按0，显式null拒绝。"
          },
          "hold_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000,
            "default": 0,
            "description": "淡入后的保持毫秒数；省略按0，显式null拒绝。"
          }
        },
        "description": "整数字段请使用普通十进制JSON整数字面量；Go int解码不接受1.0或1e0，JSON Schema本身不约束数值的词法拼写。"
      },
      "Step": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "led",
          "color",
          "fade_ms",
          "hold_ms"
        ],
        "properties": {
          "led": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "fade_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600000,
            "multipleOf": 10
          },
          "hold_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000
          }
        }
      },
      "ProgramRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "steps"
        ],
        "description": "服务端还检查 repeat × Σ(fade_ms+hold_ms+10) <= 86400000ms。10ms为每步固件更新等待；原生I/O与调度开销不属于该名义预算，不是墙钟期限。",
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "$ref": "#/components/schemas/StepRequest"
            }
          },
          "repeat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 1,
            "description": "省略或0规范为1，显式null拒绝；0不是无限循环。"
          },
          "on_finish": {
            "type": "string",
            "enum": [
              "",
              "off",
              "hold"
            ],
            "default": "off",
            "description": "省略或空字符串按off；显式null拒绝。hold保留结束时当前读回颜色；取消和daemon退出仍off。"
          }
        },
        "examples": [
          {
            "steps": [
              {
                "led": 1,
                "color": "#800000",
                "fade_ms": 100,
                "hold_ms": 0
              }
            ],
            "repeat": 1,
            "on_finish": "hold"
          },
          {
            "steps": [
              {
                "led": 0,
                "color": "#ff0000",
                "fade_ms": 300,
                "hold_ms": 500
              },
              {
                "led": 0,
                "color": "#00ff00",
                "fade_ms": 300,
                "hold_ms": 500
              },
              {
                "led": 0,
                "color": "#0000ff",
                "fade_ms": 300,
                "hold_ms": 500
              }
            ],
            "repeat": 2,
            "on_finish": "off"
          }
        ]
      },
      "Program": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "steps",
          "repeat",
          "on_finish"
        ],
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "$ref": "#/components/schemas/Step"
            }
          },
          "repeat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "on_finish": {
            "type": "string",
            "enum": [
              "off",
              "hold"
            ]
          }
        }
      },
      "SubmitRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program"
        ],
        "properties": {
          "program": {
            "$ref": "#/components/schemas/ProgramRequest"
          },
          "policy": {
            "type": "string",
            "enum": [
              "",
              "replace",
              "queue",
              "reject"
            ],
            "default": "replace",
            "description": "省略或空串按replace；显式null拒绝；replace取消旧活动/队列，queue排队，reject有工作则409。"
          },
          "request_id": {
            "type": "string",
            "pattern": "^req_[1-9][0-9]{0,18}_[0-9a-f]{32}$",
            "description": "服务端request_id_prefix追加128bit小写hex nonce。截止点是daemon单调uptime毫秒；服务端另查int64溢出、过期及最大60000ms准入窗口。"
          },
          "expected_daemon_instance_id": {
            "type": "string",
            "pattern": "^daemon_[0-9a-f]{32}$",
            "description": "原daemon实例绑定；实例改变时旧结果仍可能未知，不可自动换绑。"
          }
        },
        "description": "最大1MiB。两个可选回执字段必须同时省略或同时非空。无键调用每次新建任务；带键时同实例/serial/key的等价program及policy返回同一任务，不同payload为409。超时不能推断是否已接受，不自动降级为无键提交。",
        "examples": [
          {
            "program": {
              "steps": [
                {
                  "led": 1,
                  "color": "#800000",
                  "fade_ms": 100,
                  "hold_ms": 0
                }
              ],
              "repeat": 1,
              "on_finish": "hold"
            },
            "policy": "replace"
          }
        ],
        "dependentRequired": {
          "request_id": [
            "expected_daemon_instance_id"
          ],
          "expected_daemon_instance_id": [
            "request_id"
          ]
        }
      },
      "DeviceState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "serial",
          "product",
          "capabilities",
          "connection",
          "queue_depth"
        ],
        "properties": {
          "serial": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "description": "明确配置的真实序列号；无索引或别名解析。"
          },
          "product": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "firmware": {
            "type": "integer",
            "minimum": 0
          },
          "capabilities": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "已知能力列表；连接初期的兼容输出可能为null。"
          },
          "connection": {
            "type": "string",
            "enum": [
              "connecting",
              "online",
              "busy",
              "offline",
              "error",
              "closing",
              "closed"
            ]
          },
          "active_job": {
            "type": "string",
            "pattern": "^job_[0-9a-f]{32}$"
          },
          "queue_depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1024
          },
          "desired": {
            "$ref": "#/components/schemas/Step"
          },
          "observed": {
            "$ref": "#/components/schemas/Observation"
          },
          "last_error": {
            "type": "string"
          }
        }
      },
      "Observation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "led1",
          "led2",
          "sampled_at"
        ],
        "properties": {
          "led1": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "led2": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "sampled_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "最后一次设备RGB报告的缓存快照；不是本次GET触发的实时读，也不是相机或光学校准结果。离线时仍可保留旧采样，须同时看connection与时间。"
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "device",
          "status",
          "program",
          "completed_steps",
          "total_steps",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^job_[0-9a-f]{32}$"
          },
          "device": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "description": "明确配置的真实序列号；无索引或别名解析。"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "cancelling",
              "succeeded",
              "cancelled",
              "failed"
            ]
          },
          "program": {
            "$ref": "#/components/schemas/Program"
          },
          "completed_steps": {
            "type": "integer",
            "minimum": 0
          },
          "total_steps": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": "string"
          }
        },
        "description": "202只表示请求已接受；job终态/设备读回/相机观察不同。活动job仅在硬件停止并清理读回后才能cancelled；排队job可直接移除且不影响其他活动job。终态历史默认128条，内存保存，重启不恢复。"
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_request",
                  "invalid_json",
                  "not_found",
                  "busy",
                  "queue_full",
                  "unavailable",
                  "internal_error",
                  "local_only",
                  "method_not_allowed",
                  "json_required",
                  "body_too_large"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "api_version"
        ],
        "properties": {
          "status": {
            "const": "ok",
            "type": "string"
          },
          "api_version": {
            "const": "v1",
            "type": "string"
          }
        }
      },
      "EmptyObject": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 0
      },
      "TransportMetric": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "serial",
          "operation",
          "calls",
          "attempts",
          "retries",
          "failures"
        ],
        "description": "当前driver生命周期内累积的SDK操作级计数，不是raw USB transfer数。last_error保留历史，即使操作后来恢复。进程重启后重新累计。",
        "properties": {
          "serial": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "description": "明确配置的真实序列号；无索引或别名解析。"
          },
          "operation": {
            "type": "string"
          },
          "calls": {
            "type": "integer",
            "minimum": 0
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "retries": {
            "type": "integer",
            "minimum": 0
          },
          "failures": {
            "type": "integer",
            "minimum": 0
          },
          "last_error": {
            "type": "string"
          }
        }
      },
      "InstanceInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "daemon_instance_id",
          "idempotency"
        ],
        "properties": {
          "daemon_instance_id": {
            "type": "string",
            "pattern": "^daemon_[0-9a-f]{32}$",
            "description": "原daemon实例绑定；实例改变时旧结果仍可能未知，不可自动换绑。"
          },
          "idempotency": {
            "$ref": "#/components/schemas/IdempotencyInfo"
          }
        }
      },
      "IdempotencyInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "supported",
          "request_id_prefix",
          "accept_until_uptime_ms",
          "max_accept_window_ms",
          "receipt_retention_ms",
          "max_entries",
          "max_retained_steps"
        ],
        "properties": {
          "supported": {
            "type": "boolean"
          },
          "request_id_prefix": {
            "type": "string",
            "pattern": "^req_[1-9][0-9]{0,18}_$",
            "description": "追加32个小写hex随机字符；准备不预留回执、不提交任务。"
          },
          "accept_until_uptime_ms": {
            "type": "integer",
            "minimum": 1
          },
          "max_accept_window_ms": {
            "type": "integer",
            "minimum": 1,
            "description": "当前默认60000ms。"
          },
          "receipt_retention_ms": {
            "type": "integer",
            "minimum": 1,
            "description": "当前默认终态后至少60000ms，且不早于准入截止点；查询/重放不续期。"
          },
          "max_entries": {
            "type": "integer",
            "minimum": 1,
            "description": "当前默认全Engine4096条，不驱逐未过期/活动回执。"
          },
          "max_retained_steps": {
            "type": "integer",
            "minimum": 1,
            "description": "当前默认65536步，按原steps长度计算，不展开repeat。"
          }
        }
      },
      "RequestTicket": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "expected_daemon_instance_id"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^req_[1-9][0-9]{0,18}_[0-9a-f]{32}$",
            "description": "服务端request_id_prefix追加128bit小写hex nonce。截止点是daemon单调uptime毫秒；服务端另查int64溢出、过期及最大60000ms准入窗口。"
          },
          "expected_daemon_instance_id": {
            "type": "string",
            "pattern": "^daemon_[0-9a-f]{32}$",
            "description": "原daemon实例绑定；实例改变时旧结果仍可能未知，不可自动换绑。"
          }
        }
      }
    },
    "responses": {
      "400": {
        "description": "请求/JSON无效，未创建新job。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "403": {
        "description": "Host不是loopback或浏览器Origin不是同源。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "404": {
        "description": "未知路由、未配置设备或不存在/已淘汰的job。回执request_not_found仅表示查询当时无记录；原POST可能仍在途中。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "405": {
        "description": "方法不支持；Allow头指出允许方法。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "409": {
        "description": "设备已有工作/其他合作进程持有，或队列已满；code区分busy/queue_full。可选回执还区分idempotency_conflict与daemon_instance_changed；实例变化不证明旧意图未执行。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "413": {
        "description": "JSON体超过1MiB。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "415": {
        "description": "携带JSON体时Content-Type必须为application/json。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "500": {
        "description": "服务/原生调用错误；读取error.message。传输层没有有效HTTP响应时，不能据此推断接受结果。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "503": {
        "description": "执行器已关闭或目标设备不在线；结构化拒绝响应表示此提交没有创建job。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "410": {
        "description": "request_expired：旧token已过期且无可用回执，不再按新请求执行；不能推断此前是否执行。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "429": {
        "description": "idempotency_capacity：回执数量或步数预算已满，新键未准入；已有键仍可命中。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "501": {
        "description": "idempotency_unsupported：该服务未实现可选回执能力；不得移除绑定后自动降级提交。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
